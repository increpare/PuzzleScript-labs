menu "PuzzleScript Pocket Card"

choice POCKET_CARD_APP_MODE
    prompt "Application mode"
    default POCKET_CARD_PLAYER_APP

config POCKET_CARD_MCP23017_BENCH
    bool "MCP23017 breadboard bench test"
    help
        Scan I2C and print MCP23017 button transitions on the serial console.

config POCKET_CARD_RUNTIME_PROBE
    bool "Track 0 runtime probe"
    help
        Load the embedded IR fixture and run the automated runtime smoke trace.

config POCKET_CARD_PLAYER_APP
    bool "Interactive player (display + MCP23017 controls)"
    help
        Boot into the Pocket Card player with ILI9341 rendering and physical buttons.

endchoice

endmenu
