opam-version: "2.0"
name: "puzzlescript"
version: "0.1.0"
synopsis: "An independent, idiomatic OCaml PuzzleScript compiler and interpreter"
maintainer: "PuzzleScript contributors"
authors: "PuzzleScript contributors"
license: "MIT"
homepage: "https://github.com/increpare/PuzzleScript-labs"
depends: [
  "ocaml" {>= "5.2"}
  "dune" {>= "3.0"}
  "uucp" {>= "17.0.0"}
]
build: [ ["dune" "build" "-p" name "-j" jobs] ]
