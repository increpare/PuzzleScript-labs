  {
    "id": "history/late-direction-carryover",
    "sourceFile": "history/late-direction-carryover.ps",
    "explanation": "A late randomdir is installed after movement and survives into the next tick. Undo restores objects and clears that pending direction. Seed right-first-1 starts with 0.8744485650765657; floor(4u) = 3 selects right. Labs after upstream #1207 rejects randomdir in late rules and drops that qualifier during error recovery: the Crate stays at its original cell, while Switch is still replaced by Spent. A later tick therefore has no carried direction to resolve.",
    "cells": {
      ".": [
        "background"
      ],
      "P": [
        "background",
        "player"
      ],
      "C": [
        "background",
        "crate"
      ],
      "S": [
        "background",
        "switch"
      ],
      "s": [
        "background",
        "spent"
      ]
    },
    "cases": [
      {
        "name": "late direction waits for next turn",
        "inputs": [
          4
        ],
        "expected": [
          "s.C.P"
        ],
        "seed": "right-first-1"
      },
      {
        "name": "tick resolves carried direction",
        "inputs": [
          4,
          "tick"
        ],
        "expected": [
          "s..CP"
        ],
        "seed": "right-first-1",
        "labsExpected": [
          "s.C.P"
        ]
      },
      {
        "name": "undo removes carried direction",
        "inputs": [
          4,
          "undo",
          "tick"
        ],
        "expected": [
          "s.C.P"
        ],
        "seed": "right-first-1"
      }
    ]
  },
