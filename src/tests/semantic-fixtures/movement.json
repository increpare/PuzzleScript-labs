  {
    "id": "movement/opposing-carried-input",
    "sourceFile": "movement/opposing-carried-input.ps",
    "explanation": "Seed partial-up-1 first draws .246074, choosing Up. The late rule also consumes Switch, so it draws only once. A following Down input combines with carried Up: vanilla defines this as a zero-offset request that still collides with Player in its source layer. Both Up and Down failure sounds are recorded. This is not the general mathematical rule that opposite directions cancel.",
    "cells": {
      ".": [
        "background"
      ],
      "P": [
        "background",
        "player"
      ],
      "S": [
        "background",
        "switch"
      ],
      "s": [
        "background",
        "spent"
      ]
    },
    "cases": [
      {
        "name": "one-shot late choice waits",
        "inputs": [
          4
        ],
        "expected": [
          "s..",
          ".P.",
          "..."
        ],
        "seed": "partial-up-1",
        "expectedSounds": []
      },
      {
        "name": "opposing input is a colliding zero-offset request",
        "inputs": [
          4,
          2
        ],
        "expected": [
          "s..",
          ".P.",
          "..."
        ],
        "seed": "partial-up-1",
        "expectedSounds": [
          100,
          200
        ]
      },
      {
        "name": "failed combined request is cleared before tick",
        "inputs": [
          4,
          2,
          "tick"
        ],
        "expected": [
          "s..",
          ".P.",
          "..."
        ],
        "seed": "partial-up-1",
        "expectedSounds": [
          100,
          200
        ]
      },
      {
        "name": "undo restores the one-shot switch",
        "inputs": [
          4,
          2,
          "undo"
        ],
        "expected": [
          "S..",
          ".P.",
          "..."
        ],
        "seed": "partial-up-1",
        "expectedSounds": [
          100,
          200
        ]
      }
    ]
  }
