# GitHub Linguist hygiene for this repository.
#
# PuzzleScript is not yet a built-in Linguist language. The .puzzlescript
# mapping below is future-ready for the upstream Linguist contribution; until
# then, GitHub will only honor language names it already knows.

*.puzzlescript linguist-language=PuzzleScript

# Generated bundles/templates.
src/standalone_inlined.txt linguist-generated
bin/** linguist-generated
build/** linguist-generated

# Generated OCCT/KiCad STEP files retain exporter-emitted trailing spaces.
hardware/pocket_card/case/out/*.step -whitespace
hardware/pocket_card/case/out/order/*.step -whitespace
hardware/pocket_card/case/out/order/preview/*.step -whitespace
hardware/pocket_card/case/out/pcb/*.step -whitespace

# Firmware fixture is byte-copied PuzzleScript source for ESP-IDF embedding.
firmware/esp32p4/main/sokoban_basic.txt conflict-marker-size=32 -whitespace

# Vendored dependencies.
native/third_party/** linguist-vendored
node_modules/** linguist-vendored

# Local Linguist preparation samples should remain visible and countable once
# PuzzleScript is accepted upstream.
tools/linguist/samples/*.puzzlescript linguist-detectable

# Reproducibly generated CodeMirror runtime bundle.
src/js/codemirror6/runtime/dist/codemirror6-runtime.js linguist-generated=true
src/js/codemirror6/runtime/dist/codemirror6-runtime.js.map linguist-generated=true

# Native helper provenance hashes must survive Windows checkout conversion.
native/**/*.cpp text eol=lf
native/**/*.hpp text eol=lf
native/**/*.c text eol=lf
native/**/*.h text eol=lf
native/CMakeLists.txt text eol=lf
# Pinned compiler and GPU inputs are byte-identified snapshots.
desktop/mis/backend/authority/** -text -whitespace
native/gpu/** -text
native/gpu/cuda/** -whitespace
native/gpu/cpp/** -whitespace
native/gpu/tests/fixtures/** -whitespace
# Matplotlib keeps whitespace inside SVG path data.
docs/benchmarks/assets/**/*.svg -whitespace
native/gpu/tests/fixtures/** conflict-marker-size=256
