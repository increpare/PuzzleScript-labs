PS_HD void finish_movement_scan(u32 next){
  cursor_put_MOVE_CURSOR(next);
  if(next==cells()){
    cursor_put_MOVE_CURSOR(0u);
    if(cursor_MOVED_THIS_PASS!=0u){cursor_put_MOVED_THIS_PASS(0u);}
    else{cursor_put_PHASE(6u);cursor_put_RETRY_NEEDED(0u);}
  }
}
PS_HD void movement_tick(){
  auto idx=cursor_MOVE_CURSOR;
  if(SPARSE_RULES){
    
    
    for(auto empty=0u;empty<32u && idx<cells();empty++){
      auto pending=0u;
      for(auto w=0u;w<movement_words();w++){pending|=rd(MOVEMENTS+idx*movement_words()+w);}
      if(pending!=0u){break;}
      idx++;
    }
    if(idx==cells()){finish_movement_scan(idx);return;}
  }
  const auto pos=v2(i32(idx/game[G_HEIGHT]),i32(idx%game[G_HEIGHT]));
  for(auto l=0u;l<game[G_LAYERS];l++){
    const auto d=get5(MOVEMENTS,idx,l);
    if(d==0u){
      continue;
    }
    if(d!=1u && d!=2u && d!=4u && d!=8u && d!=16u && d!=3u && d!=15u){
      fail(7u);
      return;
    }
    const auto destination=pos+direction(d);
    if(any(destination<v2(0)) || destination.x>=i32(game[G_WIDTH]) || destination.y>=i32(game[G_HEIGHT])){
      continue;
    }
    const auto dest=u32(destination.x)*game[G_HEIGHT]+u32(destination.y);
    auto occupied=false;
    for(auto w=0u;w<object_words();w++){
      occupied=occupied || (rd(BOARD+dest*object_words()+w)&game[game[G_LAYER_BASE]+l*object_words()+w])!=0u;
    }
    if(d!=16u && occupied){
      continue;
    }
    movement_sound(idx,l);
    for(auto w=0u;w<object_words();w++){
      const auto mask=game[game[G_LAYER_BASE]+l*object_words()+w];
      const auto moving=rd(BOARD+idx*object_words()+w)&mask;
      put(BOARD+idx*object_words()+w,rd(BOARD+idx*object_words()+w)&~mask);
      put(BOARD+dest*object_words()+w,rd(BOARD+dest*object_words()+w)|moving);
      cache_object(dest,w,moving);
    }
    set5(MOVEMENTS,idx,l,0u);
    cursor_put_MOVED_THIS_PASS(1u);
  }
  finish_movement_scan(idx+1u);
}
PS_HD void rigid_cell(u32 idx,u32 pending){
  if(!SPARSE_RULES || pending!=0u){
  failed_movement_sounds(idx);
  for(auto l=0u;l<game[G_LAYERS];l++){
    if((get5(MOVEMENTS,idx,l)&get5(RIGID_APPLIED,idx,l))==0u){
      continue;
    }
    const auto ord=get5(RIGID_OWNERS,idx,l);
    const auto group=game[game[G_RIGID_BASE]+ord];
    const auto mask=1u<<(group%32u);
    if(group!=0xffffffffu && (rd(BANNED_GROUPS+group/32u)&mask)==0u){
      put(BANNED_GROUPS+group/32u,rd(BANNED_GROUPS+group/32u)|mask);
      cursor_put_RETRY_NEEDED(1u);
    }
    break;
  }
  }
  for(auto w=0u;w<movement_words();w++){
    put(MOVEMENTS+idx*movement_words()+w,0u);
    put(RIGID_OWNERS+idx*movement_words()+w,0u);
    put(RIGID_APPLIED+idx*movement_words()+w,0u);
  }
}
PS_HD void rigid_tick(){
  
  
  for(auto empty=0u;empty<select(1u,32u,SPARSE_RULES) && cursor_MOVE_CURSOR<cells() && cursor_STATUS==0u;empty++){
    const auto idx=cursor_MOVE_CURSOR;auto pending=0u;
    if(SPARSE_RULES){for(auto w=0u;w<movement_words();w++){pending|=rd(MOVEMENTS+idx*movement_words()+w);}}
    rigid_cell(idx,pending);cursor_put_MOVE_CURSOR(idx+1u);
    if(!SPARSE_RULES || pending!=0u){break;}
  }
  if(cursor_MOVE_CURSOR<cells()){
    return;
  }
  cursor_put_MOVE_CURSOR(0u);
  if(cursor_RETRY_NEEDED!=0u){
    cp(BOARD,RETRY_BOARD);
    if(LINE_PRUNE){ for(auto i=0u;i<cells();i++){ for(auto w=0u;w<object_words();w++){ cache_object(i,w,rd(BOARD+i*object_words()+w)); } } }
    cp_mov(MOVEMENTS,RETRY_MOVEMENTS);
    cursor_put_COMMANDS(0u);
    cursor_put_COMMAND_COUNT(0u);
    put(CAN_COUNT,0u);
    for(auto w=0u;w<object_words();w++){ put(CREATED_BITS+w,0u); put(DESTROYED_BITS+w,0u); }
    cursor_put_RETRIES(cursor_RETRIES+1u);
    if(cursor_RETRIES>=50u){
      cursor_put_DIAGNOSTICS(cursor_DIAGNOSTICS|4u);
      cursor_put_PHASE(7u);
      return;
    }
    cursor_put_GROUP(0u);
    cursor_put_LOOP_CHANGED(0u);
    cursor_put_LOOP_COUNT(0u);
    cursor_put_PHASE(1u);
  }
  else{
    cursor_put_LATE(1u);
    cursor_put_GROUP(game[G_EARLY_GROUPS]);
    cursor_put_LOOP_CHANGED(0u);
    cursor_put_LOOP_COUNT(0u);
    cursor_put_PHASE(1u);
  }
}
PS_HD bool has_won(){if(COOPERATIVE_MODE&&finish_win_valid)return finish_win_value;
  if((cursor_COMMANDS&4u)!=0u){
    return true;
  }
  if(game[G_WINS]==0u){
    return false;
  }
  for(auto w=0u;w<game[G_WINS];w++){
    const auto p=game[G_WIN_BASE]+w*5u;
    auto some=false;
    auto all_ok=true;
    for(auto i=0u;i<cells();i++){
      const auto a=selected(i,game[p+1u],game[p+3u]!=0u);
      const auto b=selected(i,game[p+2u],game[p+4u]!=0u);
      some=some||(a&&b);
      all_ok=all_ok&&(!a||b);
    }
    if((game[p]==0u && some)||(game[p]==1u && !some)||(game[p]==2u && !all_ok)){
      return false;
    }
  }
  return true;
}
PS_HD void finish_turn(){
  const auto cmd=cursor_COMMANDS;
  auto modified=!same(BOARD,BEFORE);
  if((game[G_FLAGS]&4u)!=0u){
    auto any_player=false;
    auto moved=false;
    for(auto i=0u;i<cells();i++){
      if(rd(PLAYER_POSITIONS+i)!=0u){
        any_player=true;
        moved=moved || !selected(i,game[G_PLAYER],false);
      }
    }
    if(any_player && !moved){
      restore(BEFORE);
      cursor_put_MODIFIED(0u);
      if(cursor_PROBING!=0u){
        cursor_put_MODIFIED(cursor_OUTER_MODIFIED);
      }
      done();
      return;
    }
  }
  if((cmd&1u)!=0u){
    if(cursor_PROBING==0u){ output_commands(); }
    restore(BEFORE);
    simple_sound(9u);
    modified=countOneBits(cmd)>1u;
    cursor_put_MODIFIED(select(0u,1u,modified));
    if(cursor_PROBING!=0u){
      cursor_put_AGAINING(select(0u,1u,modified));
      cursor_put_MODIFIED(cursor_OUTER_MODIFIED);
    }
    done();
    return;
  }
  if((cmd&2u)!=0u){
    if(cursor_PROBING==0u){ output_commands(); }
    history(BEFORE);
    if(cursor_PROBING==0u && cursor_RESTARTING==0u){
      cp(PARENT_BEFORE,BEFORE);
      cursor_put_PARENT_INPUT(cursor_INPUT_MASK);
      cursor_put_PARENT_SUPPRESS_WIN(cursor_SUPPRESS_WIN);
      restore(RESTART_BOARD);
      simple_sound(6u);
      if((game[G_FLAGS]&8u)!=0u){
        cursor_put_RESTARTING(1u);
        cursor_put_RESTART_FRAME(1u);
        cursor_put_SUPPRESS_WIN(1u);
        begin_turn(0u);
        return;
      }
    }
    modified=!same(BOARD,BEFORE);
  }
  if(cursor_PROBING!=0u){
    if(modified){
      restore(BEFORE);
    }
    else if((cmd&6u)==0u && cursor_WINNING==0u && (cmd&8u)!=0u){
      cp(RESTART_BOARD,BOARD);
      cursor_put_CHECKPOINT_USED(1u);
      cursor_put_EFFECTS(cursor_EFFECTS+1u);
    }
    cursor_put_AGAINING(select(0u,1u,modified || (cmd&6u)!=0u));
    cursor_put_MODIFIED(cursor_OUTER_MODIFIED);
    cursor_put_COMMANDS(0u);
    done();
    return;
  }
  finish_result(modified);
}
PS_HD void finish_result(bool modified){
  cursor_put_MODIFIED(select(0u,1u,modified));
  if(modified && cursor_INPUT_MASK!=0u){
    history(BEFORE);
  }
  play_sounds();
  output_commands();
  if(cursor_TEXT_MODE==0u && cursor_SUPPRESS_WIN==0u && has_won() && cursor_WINNING==0u){
    cursor_put_WINNING(1u);
    cursor_put_EFFECTS(cursor_EFFECTS+65536u);
    simple_sound(4u);
    cursor_put_AGAINING(0u);
  }
  if(cursor_WINNING==0u){
    if((cursor_COMMANDS&8u)!=0u){
      cp(RESTART_BOARD,BOARD);
      cursor_put_CHECKPOINT_USED(1u);
      cursor_put_EFFECTS(cursor_EFFECTS+1u);
    }
    if((cursor_COMMANDS&16u)!=0u && modified){
      cursor_put_OUTER_MODIFIED(cursor_MODIFIED);
      cursor_put_PROBING(1u);
      cursor_put_SAVED_MESSAGE(cursor_MESSAGE_TEXT);
      begin_turn(0u);
      return;
    }
  }
  cursor_put_COMMANDS(0u);
  cursor_put_COMMAND_COUNT(0u);
  done();
}
PS_HD void start_operation(){
  cursor_put_EPOCH(params.y);
  cursor_put_STATUS(0u);
  cursor_put_EFFECTS(0u);
  cursor_put_MODIFIED(0u);
  cursor_put_PROBING(0u);
  cursor_put_DIAGNOSTICS(0u);
  cursor_put_EVENT_COUNT(0u);
  cursor_put_SUPPRESS_WIN(0u);
  cursor_put_RESTARTING(0u);
  cursor_put_RESTART_FRAME(0u);
  if(opcode==8u){
    simple_sound(3u);
    cursor_put_SUPPRESS_WIN(1u);
    if((game[G_FLAGS]&8u)!=0u){ begin_turn(0u); }
    else{ done(); }
    return;
  }
  if(opcode==6u){
    if((game[G_FLAGS]&1u)==0u && cursor_HISTORY_COUNT>0u){
      cursor_put_HISTORY_COUNT(cursor_HISTORY_COUNT-1u);
      restore(HISTORY+cursor_HISTORY_COUNT*CELL_CAP*object_words());
      simple_sound(5u);
      cursor_put_MODIFIED(1u);
    }
    done();
    return;
  }
  if(opcode==7u){
    if((game[G_FLAGS]&2u)==0u){
      if(cursor_AGAINING!=0u && (game[G_FLAGS]&1u)==0u){
        while(true){
          if(cursor_HISTORY_COUNT==0u){
            break;
          }
          const auto at=HISTORY+(cursor_HISTORY_COUNT-1u)*CELL_CAP*object_words();
          const auto eq=same(BOARD,at);
          cursor_put_HISTORY_COUNT(cursor_HISTORY_COUNT-1u);
          if(!eq){
            restore(at);
            break;
          }
        }
      }
      history(BOARD);
      restore(RESTART_BOARD);
      simple_sound(6u);
      cursor_put_MODIFIED(1u);
      if((game[G_FLAGS]&8u)!=0u){
        cursor_put_RESTARTING(1u);
        cursor_put_RESTART_FRAME(2u);
        cursor_put_SUPPRESS_WIN(1u);
        begin_turn(0u);
        return;
      }
    }
    done();
    return;
  }
  auto input=0u;
  switch(opcode){
    case 0u:{
      input=1u;
    }break;
    case 1u:{
      input=4u;
    }break;
    case 2u:{
      input=2u;
    }break;
    case 3u:{
      input=8u;
    }break;
    case 4u:{
      input=16u;
    }break;
    default:{
    }break;
  }
  begin_turn(input);
}

PS_HD void run(u32 op,u32 epoch,u32 fuel_limit){
base=0u;line_base=0u;opcode=op;params=Params{0u,epoch,1u,fuel_limit};load_execution_registers();
if(cursor_EPOCH!=params.y){
    start_operation();
  }
  for(auto fuel=0u;fuel<(params.w&0x7fffffffu) && cursor_STATUS==0u;fuel++){
    if(cursor_PHASE<8u){
      count_work(cursor_PHASE);
    }
    switch(cursor_PHASE){
      case 1u:{
        const auto end=select(game[G_EARLY_GROUPS],game[G_GROUPS],cursor_LATE!=0u);
        if(cursor_GROUP>=end){
          if(cursor_LATE==0u){
            cursor_put_MOVE_CURSOR(0u);
            cursor_put_MOVED_THIS_PASS(0u);
            cursor_put_PHASE(5u);
          }
          else{
            cursor_put_PHASE(7u);
          }
        }
        else if(cursor_LATE==0u && (rd(BANNED_GROUPS+cursor_GROUP/32u)&(1u<<(cursor_GROUP%32u)))!=0u){
          cursor_put_PHASE(4u);
        }
        else{
          begin_group();
        }
      }break;
      case 2u:{
        
        
        for(auto m=0u;m<MATCH_CHUNK && cursor_PHASE==2u && cursor_STATUS==0u;m++){ match_tick(); }
      }break;
      case 3u:{
        apply_tick();
      }break;
      case 4u:{
        end_group();
      }break;
      case 5u:{
        movement_tick();
      }break;
      case 6u:{
        rigid_tick();
      }break;
      case 7u:{
        finish_turn();
      }break;
      case 8u:{
        finish_result(!same(BOARD,BEFORE));
      }break;
      case 9u:{
        
        
        
        for(auto skipped=0u;skipped<select(1u,32u,SPARSE_RULES) && cursor_PHASE==9u && cursor_STATUS==0u;skipped++){
          finish_rule(0u);
        }
      }break;
      default:{
        fail(8u);
      }break;
    }
  }
  save_execution_registers();
}
