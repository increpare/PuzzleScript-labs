PS_HD Vec2<i32> direction(u32 d){
  switch(d){
    case 1u:{
      return v2(0,-1);
    }break;
    case 2u:{
      return v2(0,1);
    }break;
    case 4u:{
      return v2(-1,0);
    }break;
    case 8u:{
      return v2(1,0);
    }break;
    default:{
      return v2(0,0);
    }break;
  }
}
static constexpr bool FAST_SINGLE_WORD_MATCHING=true;
PS_HD bool matches_cell(u32 c,u32 idx){
  count_work(0u);
  if(FAST_SINGLE_WORD_MATCHING && object_words()==1u){
    
    
    const auto o=rd(BOARD+idx);
    const auto required=game[game[c]];const auto absent=game[game[c+1u]];
    if((o&required)!=required || (o&absent)!=0u){return false;}
    if(movement_words()==1u){
      const auto m=rd(MOVEMENTS+idx);
      const auto moving=game[game[c+2u]];const auto stationary=game[game[c+3u]];
      if((m&moving)!=moving || (m&stationary)!=0u){return false;}
    }else if(SPARSE_RULES){
      const auto h=sparse_metadata.x+(c-game[G_CELL_BASE])/18u*8u;
      for(auto i=0u;i<game[h+3u];i++){
        const auto p=game[h+2u]+i*3u;const auto m=rd(MOVEMENTS+idx*movement_words()+game[p]);
        if((m&game[p+1u])!=game[p+1u] || (m&game[p+2u])!=0u){return false;}
      }
    }else{
      for(auto w=0u;w<movement_words();w++){
        const auto m=rd(MOVEMENTS+idx*movement_words()+w);
        if((m&game[game[c+2u]+w])!=game[game[c+2u]+w] || (m&game[game[c+3u]+w])!=0u){return false;}
      }
    }
    for(auto a=0u;a<game[c+4u];a++){
      if(!selected(idx,game[c+5u+a],false)){return false;}
    }
    return true;
  }
  if(SPARSE_RULES){
    const auto h=sparse_metadata.x+(c-game[G_CELL_BASE])/18u*8u;
    for(auto i=0u;i<game[h+1u];i++){
      const auto p=game[h]+i*3u;const auto o=rd(BOARD+idx*object_words()+game[p]);
      if((o&game[p+1u])!=game[p+1u] || (o&game[p+2u])!=0u){return false;}
    }
    for(auto i=0u;i<game[h+3u];i++){
      const auto p=game[h+2u]+i*3u;const auto m=rd(MOVEMENTS+idx*movement_words()+game[p]);
      if((m&game[p+1u])!=game[p+1u] || (m&game[p+2u])!=0u){return false;}
    }
    for(auto a=0u;a<game[c+4u];a++){
      if(!selected(idx,game[c+5u+a],false)){return false;}
    }
    return true;
  }
  for(auto w=0u;w<object_words();w++){
    const auto o=rd(BOARD+idx*object_words()+w);
    if((o&game[game[c]+w])!=game[game[c]+w] || (o&game[game[c+1u]+w])!=0u){ return false; }
  }
  for(auto w=0u;w<movement_words();w++){
    const auto m=rd(MOVEMENTS+idx*movement_words()+w);
    if((m&game[game[c+2u]+w])!=game[game[c+2u]+w] || (m&game[game[c+3u]+w])!=0u){ return false; }
  }
  for(auto a=0u;a<game[c+4u];a++){
    if(!selected(idx,game[c+5u+a],false)){ return false; }
  }
  return true;
}



PS_HD bool matches_prefix(u32 row,u32 start){
  const auto rp=row_ptr(row);
  const auto step=direction(game[rule_ptr()]);
  auto p=v2(i32(start/game[G_HEIGHT]),i32(start%game[G_HEIGHT]));
  for(auto i=0u;i<game[rp+1u];i++){
    const auto c=cell_ptr(game[rp]+i);
    if(game[c+17u]!=0u){ return true; }
    if(any(p<v2(0)) || p.x>=i32(game[G_WIDTH]) || p.y>=i32(game[G_HEIGHT])){ return false; }
    if(!matches_cell(c,u32(p.x)*game[G_HEIGHT]+u32(p.y))){ return false; }
    p+=step;
  }
  return true;
}
static constexpr bool FLAT_ROW_MATCHING=true;
PS_HD bool matches_flat_row(u32 rp,u32 d,u32 start){
  const auto length=game[rp+1u];
  if(length==0u){return true;}
  if(start>=cells()){return false;}
  const auto vertical=d==1u || d==2u;const auto backward=d==1u || d==4u;
  const auto position=select(start/game[G_HEIGHT],start%game[G_HEIGHT],vertical);
  const auto span=select(game[G_WIDTH],game[G_HEIGHT],vertical);
  if(backward){if(length>position+1u){return false;}}
  else{if(length>span-position){return false;}}
  const auto stride=select(i32(game[G_HEIGHT]),1,vertical);
  const auto delta=select(stride,-stride,backward);
  auto index=i32(start);
  for(auto i=0u;i<length;i++){
    if(!matches_cell(cell_ptr(game[rp]+i),u32(index))){return false;}
    index+=delta;
  }
  return true;
}
PS_HD bool matches(u32 row,u32 start,Vec2<u32> gaps){
  const auto rp=row_ptr(row);
  const auto d=game[rule_ptr()];
  if(FLAT_ROW_MATCHING && game[rp+2u]==0u && (d==1u || d==2u || d==4u || d==8u)){
    return matches_flat_row(rp,d,start);
  }
  const auto step=direction(d);
  auto p=v2(i32(start/game[G_HEIGHT]),i32(start%game[G_HEIGHT]));
  auto ellipse=0u;
  for(auto i=0u;i<game[rp+1u];i++) {
    const auto c=cell_ptr(game[rp]+i);
    if(game[c+17u]!=0u){
      p+=step*i32(gaps[ellipse]);
      ellipse++;
      continue;
    }
    if(any(p<v2(0)) || p.x>=i32(game[G_WIDTH]) || p.y>=i32(game[G_HEIGHT])){
      return false;
    }
    const auto idx=u32(p.x)*game[G_HEIGHT]+u32(p.y);
    if(!matches_cell(c,idx)){ return false; }
    p+=step;
  }
  return true;
}
PS_HD u32 next_byte(){
  const auto i=(cursor_RNG_I+1u)&255u;
  const auto j=(cursor_RNG_J+rd(RNG_DATA+i))&255u;
  const auto a=rd(RNG_DATA+i);
  put(RNG_DATA+i,rd(RNG_DATA+j));
  put(RNG_DATA+j,a);
  cursor_put_RNG_I(i);
  cursor_put_RNG_J(j);
  return rd(RNG_DATA+((rd(RNG_DATA+i)+rd(RNG_DATA+j))&255u));
}


struct Limbs { Array<u32,5u> v; };
PS_HD Limbs round53(Limbs input){
  auto a=input;
  auto bits=0u;
  for(auto i=0u;i<5u;i++){
    if(a.v[i]!=0u){
      bits=i*16u+32u-countLeadingZeros(a.v[i]);
    }
  }
  if(bits<=53u){
    return a;
  }
  const auto shift=bits-53u;
  const auto limb=shift/16u;
  const auto offset=shift%16u;
  auto lower=false;
  for(auto i=0u;i<limb;i++){
    lower=lower || a.v[i]!=0u;
  }
  const auto half=1u<<((shift-1u)%16u);
  const auto hi=(shift-1u)/16u;
  auto below=lower;
  if(offset==0u){
    below=false;
    for(auto i=0u;i<hi;i++){
      below=below||a.v[i]!=0u;
    }
  }
  below=below || (a.v[hi]&(half-1u))!=0u;
  const auto up=(a.v[hi]&half)!=0u && (below || ((a.v[limb]>>offset)&1u)!=0u);
  for(auto i=0u;i<limb;i++){
    a.v[i]=0u;
  }
  a.v[limb]&=~((1u<<offset)-1u);
  if(up){
    a.v[limb]+=1u<<offset;
    for(auto i=limb;i<4u;i++){
      a.v[i+1u]+=a.v[i]>>16u;
      a.v[i]&=65535u;
    }
  }
  return a;
}
PS_HD u32 choose(u32 n){
  Limbs a{};
  for(auto b=0u;b<7u;b++){
    auto carry=next_byte();
    for(auto i=0u;i<5u;i++){
      const auto v=a.v[i]*256u+carry;
      a.v[i]=v&65535u;
      carry=v>>16u;
    }
  }
  a=round53(a);
  auto carry=0u;
  for(auto i=0u;i<5u;i++){
    const auto v=a.v[i]*n+carry;
    a.v[i]=v&65535u;
    carry=v>>16u;
  }
  a=round53(a);
  return (a.v[3u]>>8u)|(a.v[4u]<<8u);
}
PS_HD bool sparse_replace(u32 c,u32 idx){
  const auto h=sparse_metadata.x+(c-game[G_CELL_BASE])/18u*8u;
  auto changed=false;
  for(auto i=0u;i<game[h+5u];i++){
    const auto p=game[h+4u]+i*3u;const auto encoded=game[p];const auto w=encoded&0x7fffffffu;
    if((encoded&0x80000000u)==0u){
      const auto old=rd(BOARD+idx*object_words()+w);const auto after=(old&~game[p+1u])|game[p+2u];
      put(BOARD+idx*object_words()+w,after);cache_object(idx,w,after&~old);
      add_global_objects(w,after);
      put(CREATED_BITS+w,rd(CREATED_BITS+w)|(after&~old));
      put(DESTROYED_BITS+w,rd(DESTROYED_BITS+w)|(old&~after));
      changed=changed || old!=after;
    }else{
      const auto old=rd(MOVEMENTS+idx*movement_words()+w);const auto after=(old&~game[p+1u])|game[p+2u];
      put(MOVEMENTS+idx*movement_words()+w,after);cache_movement(w,after);changed=changed || old!=after;
    }
  }
  return changed;
}
PS_HD bool replace(u32 row,u32 start,Vec2<u32> gaps){
  const auto rp=row_ptr(row);
  const auto step=direction(game[rule_ptr()]);
  auto p=v2(i32(start/game[G_HEIGHT]),i32(start%game[G_HEIGHT]));
  auto ellipse=0u;
  auto changed=false;
  for(auto i=0u;i<game[rp+1u];i++){
    const auto c=cell_ptr(game[rp]+i);
    if(game[c+17u]!=0u){
      p+=step*i32(gaps[ellipse]);
      ellipse++;
      continue;
    }
    const auto idx=u32(p.x)*game[G_HEIGHT]+u32(p.y);
    if(game[c+9u]!=0u){
      const auto sparse_header=sparse_metadata.x+(c-game[G_CELL_BASE])/18u*8u;
      if(SPARSE_RULES && game[sparse_header+6u]==0u && game[rule_ptr()+4u]==0u){
        changed=sparse_replace(c,idx)||changed;
      }else{
      Array<u32,(FixedOW?FixedOW:32)> oc{};
      Array<u32,(FixedOW?FixedOW:32)> os{};
      Array<u32,(FixedMW?FixedMW:64)> mc{};
      Array<u32,(FixedMW?FixedMW:64)> ms{};
      auto n=0u;
      for(auto w=0u;w<object_words();w++){
        oc[w]=game[game[c+10u]+w]; os[w]=game[game[c+11u]+w];
        n+=countOneBits(game[game[c+15u]+w]);
      }
      for(auto w=0u;w<movement_words();w++){
        mc[w]=game[game[c+12u]+w]|game[game[c+14u]+w]; ms[w]=game[game[c+13u]+w];
      }
      if(n!=0u){
        auto wanted=choose(n);
        if(wanted>=n){
          fail(6u);
          return false;
        }
        for(auto o=0u;o<game[G_OBJECTS];o++){
          const auto word=o/32u;
          const auto mask=1u<<(o%32u);
          if((game[game[c+15u]+word]&mask)==0u){
            continue;
          }
          if(wanted>0u){
            wanted--;
            continue;
          }
          os[word]|=mask;
          for(auto l=0u;l<game[G_LAYERS];l++){
            if((game[game[G_LAYER_BASE]+l*object_words()+word]&mask)!=0u){
              for(auto w=0u;w<object_words();w++){ oc[w]|=game[game[G_LAYER_BASE]+l*object_words()+w]; }
              for(auto w=0u;w<movement_words();w++){ mc[w]|=shifted5(l,w,31u); }
            }
          }
          break;
        }
      }
      for(auto l=0u;l<game[G_LAYERS];l++){
        const auto bit=l*5u;
        if((game[game[c+16u]+bit/32u]&(1u<<(bit%32u)))!=0u){
          const auto movement=1u<<choose(4u);
          for(auto w=0u;w<movement_words();w++){ ms[w]|=shifted5(l,w,movement); }
        }
      }
      for(auto w=0u;w<object_words();w++){
        const auto old=rd(BOARD+idx*object_words()+w);
        const auto after=(old&~oc[w])|os[w];
        put(BOARD+idx*object_words()+w,after);
        cache_object(idx,w,after&~old);
        add_global_objects(w,after);
        put(CREATED_BITS+w,rd(CREATED_BITS+w)|(after&~old));
        put(DESTROYED_BITS+w,rd(DESTROYED_BITS+w)|(old&~after));
        changed=changed || old!=after;
      }
      for(auto w=0u;w<movement_words();w++){
        const auto old=rd(MOVEMENTS+idx*movement_words()+w);
        const auto after=(old&~mc[w])|ms[w];
        put(MOVEMENTS+idx*movement_words()+w,after);
        cache_movement(w,after);
        changed=changed || old!=after;
      }
      const auto ord=game[rule_ptr()+4u];
      if(ord!=0u){
        Array<u32,(FixedMW?FixedMW:64)> rigid{};
        auto contains_owner=true;
        auto contains_applied=true;
        for(auto w=0u;w<movement_words();w++){
          auto bits=0u;
          for(auto l=0u;l<game[G_LAYERS];l++){ bits|=shifted5(l,w,ord); }
          rigid[w]=bits&game[game[c+14u]+w];
          contains_owner=contains_owner && (rd(RIGID_OWNERS+idx*movement_words()+w)&rigid[w])==rigid[w];
          contains_applied=contains_applied && (rd(RIGID_APPLIED+idx*movement_words()+w)&game[game[c+14u]+w])==game[game[c+14u]+w];
        }
        if(!contains_owner && !contains_applied){
          for(auto w=0u;w<movement_words();w++){
            const auto at=idx*movement_words()+w;
            put(RIGID_OWNERS+at,rd(RIGID_OWNERS+at)|rigid[w]);
            put(RIGID_APPLIED+at,rd(RIGID_APPLIED+at)|game[game[c+14u]+w]);
          }
          changed=true;
        }
      }
    }
      }
    p+=step;
  }
  return changed;
}
PS_HD void queue_commands(){
  const auto cmd=game[rule_ptr()+3u];
  const auto old=cursor_COMMANDS;
  if(cmd==0u || (old&1u)!=0u || ((old&2u)!=0u && (cmd&1u)==0u)){
    return;
  }
  if((cmd&3u)!=0u){
    cursor_put_COMMANDS(0u);
    cursor_put_COMMAND_COUNT(0u);
    cursor_put_MESSAGE_TEXT(0u);
  }
  const auto p=game[rule_ptr()+7u];
  for(auto i=0u;i<game[p];i++){
    const auto command=game[p+1u+i*2u];
    const auto bit=1u<<command;
    if((cursor_COMMANDS&bit)!=0u){ continue; }
    const auto count=cursor_COMMAND_COUNT;
    if(count>=32u){ fail(13u); return; }
    put(COMMAND_LIST+count,command);
    cursor_put_COMMAND_COUNT(count+1u);
    cursor_put_COMMANDS(cursor_COMMANDS|bit);
    if(command==5u){ cursor_put_MESSAGE_TEXT(game[p+2u+i*2u]); }
  }
}
PS_HD void begin_rule(){if(COOPERATIVE_MODE){shared->prefix_valid=0u;}
  if(MATCH_PRUNE && SPARSE_RULES){
    auto possible=true;
    if(eligible_rule_cached(cursor_RULE)){possible=(shared->eligible_rule_bits&(1u<<(cursor_RULE-shared->eligible_rule_start)))!=0u;}
    else{possible=sparse_possible_rule(cursor_RULE);}
    if(!possible){cursor_put_PHASE(9u);return;}
  }
  cursor_put_SCAN_LINE(0xffffffffu);
  cursor_put_SCAN_ROW(0u);
  cursor_put_SCAN_CELL(0u);
  cursor_put_SCAN_GAP(0u);
  cursor_put_TUPLE(0u);
  for(auto i=0u;i<game[rule_ptr()+2u];i++){
    put(MATCH_COUNTS+i,0u);
  }
  if(MATCH_PRUNE && !SPARSE_RULES){
    for(auto row=0u;row<game[rule_ptr()+2u];row++){
      const auto mask=game[row_ptr(row)+3u];
      for(auto w=0u;w<object_words();w++){
        if((rd(GLOBAL_OBJECTS+w)&game[mask+w])!=game[mask+w]){
          cursor_put_PHASE(9u);
          return;
        }
      }
    }
  }
  cursor_put_PHASE(2u);
}
PS_HD void begin_group(){
