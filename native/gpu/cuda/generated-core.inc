  cursor_put_PASS_CHANGED(0u);
  cursor_put_RANDOM_PASS(0u);
  cursor_put_RANDOM_TOTAL(0u);
  cursor_put_RANDOM_CHOICE(0u);
  
  
  
  if(SPARSE_RULES && !sparse_possible_group(cursor_GROUP)){
    const auto gp=group_ptr();cursor_put_RULE(game[gp]+game[gp+1u]-1u);
    finish_rule(0u);end_group();return;
  }
  begin_rule();
}
PS_HD void begin_turn(u32 input){
  if(COOPERATIVE_MODE){shared->eligible_rule_valid=0u;shared->eligible_line_valid=0u;shared->prefix_valid=0u;}
  cp(BEFORE,BOARD);
  cursor_put_COMMANDS(0u);
  cursor_put_COMMAND_COUNT(0u);
  put(CAN_COUNT,0u);
  put(CANT_COUNT,0u);
  cursor_put_AGAINING(0u);
  for(auto w=0u;w<object_words();w++){ put(CREATED_BITS+w,0u); put(DESTROYED_BITS+w,0u); }
  for(auto w=0u;w<object_words();w++){ put(GLOBAL_OBJECTS+w,0u); }
  for(auto w=0u;w<BAN_WORDS;w++){ put(BANNED_GROUPS+w,0u); }
  cursor_put_RETRIES(0u);
  put(32u,0u);
  cursor_put_LOOP_COUNT(0u);
  cursor_put_INPUT_MASK(input);
  if(LINE_PRUNE){
    for(auto i=0u;i<(game[G_WIDTH]+game[G_HEIGHT])*object_words();i++){ line_objects[line_base+i]=0u; }
  }
  if(MOVEMENT_GUARDS){for(auto w=0u;w<movement_words();w++){line_objects[global_movement_base()+w]=0u;}}
  for(auto i=0u;i<cells();i++){
    for(auto w=0u;w<object_words();w++){ const auto value=rd(BOARD+i*object_words()+w); put(GLOBAL_OBJECTS+w,rd(GLOBAL_OBJECTS+w)|value); cache_object(i,w,value); }
    const auto is_player=selected(i,game[G_PLAYER],game[G_AGGREGATE_PLAYER]!=0u);
    put(PLAYER_POSITIONS+i,select(0u,1u,is_player && input!=0u));
    if(is_player && input!=0u){
      for(auto l=0u;l<game[G_LAYERS];l++){
        auto in_layer=false;
        for(auto w=0u;w<object_words();w++){
          in_layer=in_layer || (rd(BOARD+i*object_words()+w)&game[game[G_PLAYER]+w]&game[game[G_LAYER_BASE]+l*object_words()+w])!=0u;
        }
        if(in_layer){
          set5(MOVEMENTS,i,l,get5(MOVEMENTS,i,l)|input);
        }
      }
    }
  }
  
  
  if(MOVEMENT_GUARDS){for(auto i=0u;i<cells();i++){for(auto w=0u;w<movement_words();w++){cache_movement(w,rd(MOVEMENTS+i*movement_words()+w));}}}
  cp(RETRY_BOARD,BOARD);
  cp_mov(RETRY_MOVEMENTS,MOVEMENTS);
  cursor_put_GROUP(0u);
  cursor_put_LATE(0u);
  cursor_put_LOOP_CHANGED(0u);
  cursor_put_PHASE(1u);
}
PS_HD void finish_rule(u32 total){
  const auto gp=group_ptr();
  if(game[gp+2u]!=0u){
    if(cursor_RANDOM_PASS==0u){
      if(cursor_RANDOM_TOTAL+total>65535u){
        fail(5u);
        return;
      }
      cursor_put_RANDOM_TOTAL(cursor_RANDOM_TOTAL+total);
    }
    else if(cursor_RANDOM_CHOICE<total){
      cursor_put_TUPLE(cursor_RANDOM_CHOICE);
      cursor_put_PHASE(3u);
      return;
    }
    else{
      cursor_put_RANDOM_CHOICE(cursor_RANDOM_CHOICE-total);
    }
  }
  else if(total>0u){
    cursor_put_TUPLE(0u);
    cursor_put_PHASE(3u);
    return;
  }
  next_rule();
}
PS_HD void next_rule(){
  const auto gp=group_ptr();
  cursor_put_RULE(cursor_RULE+1u);
  if(cursor_RULE<game[gp]+game[gp+1u]){
    begin_rule();
    return;
  }
  if(game[gp+2u]!=0u && cursor_RANDOM_PASS==0u && cursor_RANDOM_TOTAL>0u){
    cursor_put_RANDOM_CHOICE(choose(cursor_RANDOM_TOTAL));
    if(cursor_RANDOM_CHOICE>=cursor_RANDOM_TOTAL){
      fail(6u);
      return;
    }
    cursor_put_RANDOM_PASS(1u);
    cursor_put_RULE(game[gp]);
    begin_rule();
    return;
  }
  if(game[gp+2u]==0u){
    cursor_put_GROUP_PASSES(cursor_GROUP_PASSES+1u);
    if(cursor_GROUP_PASSES>=200u){
      cursor_put_DIAGNOSTICS(cursor_DIAGNOSTICS|1u);
    }
    else if(cursor_PASS_CHANGED!=0u){
      cursor_put_PASS_CHANGED(0u);
      cursor_put_RULE(game[gp]);
      begin_rule();
      return;
    }
  }
  cursor_put_PHASE(4u);
}
PS_HD void end_group(){
  const auto gp=group_ptr();
  auto next=cursor_GROUP+1u;
  auto destination=game[gp+3u];
  const auto end=select(game[G_EARLY_GROUPS],game[G_GROUPS],cursor_LATE!=0u);
  if(next==end && destination==0xffffffffu){
    destination=select(game[G_EARLY_END_LOOP],game[G_LATE_END_LOOP],cursor_LATE!=0u);
  }
  if(cursor_LOOP_CHANGED!=0u && destination!=0xffffffffu){
    next=destination;
    cursor_put_LOOP_CHANGED(0u);
    cursor_put_LOOP_COUNT(cursor_LOOP_COUNT+1u);
    if(cursor_LOOP_COUNT>200u){
      cursor_put_DIAGNOSTICS(cursor_DIAGNOSTICS|2u);
      next=end;
    }
  }
  cursor_put_GROUP(next);
  cursor_put_PHASE(1u);
}
PS_HD void finish_matching_row(u32 row){
  cursor_put_SCAN_LINE(0xffffffffu);
  if(rd(MATCH_COUNTS+row)==0u){ finish_rule(0u); return; }
  cursor_put_SCAN_ROW(row+1u); cursor_put_SCAN_CELL(0u); cursor_put_SCAN_GAP(0u);
  if(cursor_SCAN_ROW<game[rule_ptr()+2u]){ return; }
  auto total=1u;
  for(auto r=0u;r<game[rule_ptr()+2u];r++){
    if(total>65535u/rd(MATCH_COUNTS+r)){ fail(5u); return; }
    total*=rd(MATCH_COUNTS+r);
  }
  cursor_put_TUPLE_COUNT(total); finish_rule(total);
}
PS_HD u32 scan_origin(u32 scan,u32 d){
  return select((scan%game[G_WIDTH])*game[G_HEIGHT]+scan/game[G_WIDTH],scan,d==1u || d==2u);
}
PS_HD void match_tick(){
  const auto row=cursor_SCAN_ROW;
  const auto rp=row_ptr(row);
  auto scan=cursor_SCAN_CELL;
  const auto gap=cursor_SCAN_GAP;
  const auto d=game[rule_ptr()];
  const auto span=select(game[G_WIDTH],game[G_HEIGHT],d==1u || d==2u);
  if(LINE_PRUNE && gap==0u && !possible_line(row,scan,d)){
    const auto next=(scan/span+1u)*span;
    cursor_put_SCAN_CELL(next);
    if(next>=cells()){ finish_matching_row(row); }
    return;
  }
  if(gap==0u){
    const auto first=cell_ptr(game[rp]);
    auto anchor_word=0u;
    auto anchor_bits=0u;
    if(game[first+17u]==0u){
      for(auto w=0u;w<object_words();w++){
        if(game[game[first]+w]!=0u){ anchor_word=w; anchor_bits=game[game[first]+w]; }
      }
    }
    if(anchor_bits!=0u){
      const auto end=min(min(cells(),scan+ANCHOR_SCAN),select(cells(),(scan/span+1u)*span,LINE_PRUNE));
      while(true){
        if(scan>=end){
          cursor_put_SCAN_CELL(scan);
          if(scan>=cells()){ finish_matching_row(row); }
          return;
        }
        const auto origin=scan_origin(scan,d);
        if((rd(BOARD+origin*object_words()+anchor_word)&anchor_bits)==anchor_bits){ break; }
        scan++;
      }
      cursor_put_SCAN_CELL(scan);
    }
  }
  const auto start=scan_origin(scan,d);
  const auto ellipses=game[rp+2u];
  const auto x=i32(start/game[G_HEIGHT]);
  const auto y=i32(start%game[G_HEIGHT]);
  const auto length=i32(game[rp+1u]-ellipses);
  auto limit=1u;
  if(ellipses!=0u){
    switch(d){
      case 1u:{ limit=u32(max(0,y-length+2)); }break;
      case 2u:{ limit=u32(max(0,i32(game[G_HEIGHT])-y-length+1)); }break;
      case 4u:{ limit=u32(max(0,x-length+2)); }break;
      case 8u:{ limit=u32(max(0,i32(game[G_WIDTH])-x-length+1)); }break;
      default:{ limit=0u; }break;
    }
  }
  const auto divisor=max(1u,limit);
  const auto gaps=select(v2(gap,0u),v2(gap/divisor,gap%divisor),ellipses==2u);
  const auto impossible_prefix=MATCH_PREFIX_PRUNE && ellipses!=0u && gap==0u && !matches_prefix(row,start);
  if(!impossible_prefix && limit>0u && matches(row,start,gaps)){
    const auto count=rd(MATCH_COUNTS+row);
    if(count>=MATCH_CAP){
      fail(3u);
      return;
    }
    const auto at=MATCHES+(row*MATCH_CAP+count)*3u;
    put(at,start);
    put(at+1u,gaps.x);
    put(at+2u,gaps.y);
    put(MATCH_COUNTS+row,count+1u);
  }
  const auto maxgap=select(divisor,divisor*divisor,ellipses==2u);
  auto next=gap+1u;
  if(ellipses==2u && gaps.x+gaps.y+1u>=limit){ next=(gaps.x+1u)*divisor; }
  if(impossible_prefix){ next=maxgap; }
  cursor_put_SCAN_GAP(next);
  if(cursor_SCAN_GAP<maxgap){
    return;
  }
  cursor_put_SCAN_GAP(0u);
  cursor_put_SCAN_CELL(scan+1u);
  if(cursor_SCAN_CELL<cells()){
    return;
  }
  finish_matching_row(row);
}
#if defined(PS_CUDA_STREAM_TUPLES) && PS_CUDA_STREAM_TUPLES
PS_HD void apply_tick(){
  auto tuple=cursor_TUPLE;
  auto valid=true;
  // Every live row recheck precedes every replacement, including overlaps.
  for(auto r=0u;r<game[rule_ptr()+2u];r++){
    const auto count=rd(MATCH_COUNTS+r);
    const auto at=MATCHES+(r*MATCH_CAP+tuple%count)*3u;
    tuple/=count;
    const auto start=rd(at);
    const auto gaps=v2(rd(at+1u),rd(at+2u));
    valid=valid && matches(r,start,gaps);
  }
  if(valid && game[rule_ptr()+5u]!=0u){
    auto changed=false;
    // Replacement changes board/movement/RNG/rigid state, never the collected
    // match records or counts. Decode the same tuple again in original order.
    tuple=cursor_TUPLE;
    for(auto r=0u;r<game[rule_ptr()+2u];r++){
      const auto count=rd(MATCH_COUNTS+r);
      const auto at=MATCHES+(r*MATCH_CAP+tuple%count)*3u;
      tuple/=count;
      const auto start=rd(at);
      const auto gaps=v2(rd(at+1u),rd(at+2u));
      changed=replace(r,start,gaps)||changed;
    }
    if(changed){cursor_put_PASS_CHANGED(1u);cursor_put_LOOP_CHANGED(1u);}
  }
  if(game[group_ptr()+2u]!=0u){
    queue_commands();
    cursor_put_PHASE(4u);
    return;
  }
  cursor_put_TUPLE(cursor_TUPLE+1u);
  if(cursor_TUPLE>=cursor_TUPLE_COUNT){
    queue_commands();
    next_rule();
  }
}
