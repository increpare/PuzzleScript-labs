{
  "meta": {
    "project": "PuzzleScript P4 Handheld",
    "revision": "circuit-phase-0",
    "date": "2026-07-12",
    "mcu": "ESP32-P4NRW32X chip-down"
  },
  "blocks": [
    {
      "id": "power",
      "name": "Power",
      "nets_out": ["+3V3", "+3V3_PANEL", "GND", "BAT+", "VBUS_IN", "SYS", "PWR_EN", "PANEL_EN"],
      "parts": [
        { "ref": "J1", "kind": "usb-c", "role": "charge + USB 2.0 HS to P4 PHY" },
        { "ref": "J2", "kind": "battery-connector", "gate": "GATE-BATTERY-SAMPLE", "role": "protected 1S LiPo, cell chosen at mechanical phase" },
        { "ref": "U2", "kind": "charger-power-path", "selected": "BQ24075RGTR" },
        { "ref": "U3", "kind": "fuel-gauge-i2c", "selected": "MAX17048G+T10" },
        { "ref": "U4", "kind": "buck-boost-3v3", "selected": "TPS63070" },
        { "ref": "U6", "kind": "panel-load-switch", "selected": "TPS22919DCK" },
        { "ref": "SW9", "kind": "spdt-slide-switch", "gate": "GATE-POWER-SLIDE-SLOT", "role": "gates U4 EN; hard off; charging works with switch off" },
        { "ref": "D4", "kind": "charge-led", "role": "lit from VBUS via charger CHG pin" }
      ]
    },
    {
      "id": "compute",
      "name": "Compute",
      "nets_in": ["+3V3", "GND", "ESP_EN"],
      "nets_out": ["DSI_*", "USB_DP", "USB_DM", "I2C_SDA", "I2C_SCL", "I2S_*", "SD_*", "BTN_*"],
      "parts": [
        { "ref": "U1", "kind": "ESP32-P4NRW32X", "note": "chip-down, no radio; cluster copied from hardware/card, diffed against Espressif reference" },
        { "ref": "U9", "kind": "qspi-nor-32mb", "gate": "GATE-ESP32-P4-REF-CAPTURE" },
        { "ref": "X1", "kind": "40mhz-crystal", "gate": "GATE-ESP32-P4-REF-CAPTURE" },
        { "ref": "L1", "kind": "dcdc-inductor-2u2", "gate": "GATE-ESP32-P4-REF-CAPTURE" }
      ]
    },
    {
      "id": "display",
      "name": "Display",
      "nets_in": ["+3V3_PANEL", "DSI_*", "I2C_SDA", "I2C_SCL"],
      "parts": [
        { "ref": "J3", "kind": "panel-ffc", "gate": "GATE-PANEL-FFC-CONTACT", "role": "small MIPI-DSI panel per PANEL_RESEARCH.md" }
      ]
    },
    {
      "id": "controls",
      "name": "Controls",
      "parts": [
        { "ref": "SW1-SW8", "kind": "buttons", "gate": "GATE-BUTTON-COUPON", "role": "direct-GPIO, active-low, no expander" },
        { "ref": "SW10A/SW10B", "kind": "volume", "gate": "GATE-BUTTON-COUPON" }
      ]
    },
    {
      "id": "storage",
      "name": "Storage",
      "parts": [
        { "ref": "J4", "kind": "microsd-sdmmc", "gate": "GATE-MICROSD-FOOTPRINT", "role": ".pscart cartridge library" }
      ]
    },
    {
      "id": "audio",
      "name": "Audio",
      "parts": [
        { "ref": "U7", "kind": "i2s-mono-amp", "selected": "MAX98357A" },
        { "ref": "J5", "kind": "speaker-connector", "gate": "GATE-SPEAKER-SELECT", "role": "hand-attached dynamic speaker" }
      ]
    },
    {
      "id": "debug",
      "name": "Debug",
      "parts": [
        { "ref": "TP*", "kind": "test-pads", "role": "UART, EN, BOOT, spare GPIOs; no connector in v1" }
      ]
    }
  ]
}
