{
  "meta": {
    "project": "PuzzleScript Card",
    "revision": "spin1-draft",
    "date": "2026-07-08",
    "mcu": "Waveshare ESP32-P4-Module-32MB"
  },
  "blocks": [
    {
      "id": "power",
      "name": "Power",
      "nets_out": ["+3V3", "GND", "BAT+", "VBUS_IN", "SYS", "ESP_EN"],
      "parts": [
        { "ref": "J1", "kind": "USB-C-mid-mount", "role": "charge + USB-2-OTG" },
        { "ref": "J2", "kind": "battery-connector", "role": "1S pouch" },
        { "ref": "U2", "kind": "charger-power-path", "candidates": ["BQ24075", "BQ25895"] },
        { "ref": "U3", "kind": "fuel-gauge-i2c", "candidates": ["MAX17048"] },
        { "ref": "U4", "kind": "buck-3v3", "candidates": ["TPS62135", "MP2359"] }
      ]
    },
    {
      "id": "compute",
      "name": "Compute",
      "nets_in": ["+3V3", "GND", "ESP_EN"],
      "nets_out": ["DSI_*", "USB_DP", "USB_DM", "I2C_SDA", "I2C_SCL", "GPIO_*"],
      "parts": [
        { "ref": "U1", "kind": "ESP32-P4-Module-32MB", "footprint": "25x25-castellated-1mm" }
      ]
    },
    {
      "id": "display",
      "name": "Display",
      "nets_in": ["+3V3", "GND", "DSI_D0_P", "DSI_D0_N", "DSI_D1_P", "DSI_D1_N", "DSI_CLK_P", "DSI_CLK_N"],
      "parts": [
        { "ref": "J3", "kind": "FFC-15-1.0mm", "role": "WS24773 DSI panel" }
      ],
      "rules": ["100-ohm-diff", "length-match-pairs", "4-layer"]
    },
    {
      "id": "controls",
      "name": "Controls",
      "nets_in": ["+3V3", "GND", "GPIO_*"],
      "parts": [
        { "ref": "SW1-4", "kind": "tact", "role": "dpad" },
        { "ref": "SW5-7", "kind": "tact", "role": "action-undo-restart" },
        { "ref": "SW8", "kind": "tact", "role": "menu" },
        { "ref": "SW9", "kind": "edge", "role": "power" },
        { "ref": "SW10", "kind": "rocker", "role": "volume" }
      ]
    },
    {
      "id": "storage",
      "name": "Storage",
      "nets_in": ["+3V3", "GND", "SDIO_or_SPI"],
      "parts": [{ "ref": "J4", "kind": "microSD", "role": "internal-service" }]
    },
    {
      "id": "audio",
      "name": "Audio",
      "nets_in": ["PIEZO_PWM", "GND"],
      "parts": [
        { "ref": "Q1", "kind": "npn", "role": "piezo-drive" },
        { "ref": "JP1", "kind": "wire-pads", "role": "shell-piezo" }
      ]
    },
    {
      "id": "haptic",
      "name": "Haptic",
      "nets_in": ["I2C_SDA", "I2C_SCL", "+3V3", "GND"],
      "parts": [
        { "ref": "U5", "kind": "DRV2605L", "role": "lra-driver" },
        { "ref": "B1", "kind": "LRA", "role": "haptic-actuator" }
      ]
    },
    {
      "id": "led",
      "name": "Case RGB",
      "nets_in": ["LED_R", "LED_G", "LED_B", "GND"],
      "parts": [{ "ref": "D1-3", "kind": "side-rgb", "role": "shell-light-pipe" }]
    },
    {
      "id": "debug",
      "name": "Debug",
      "nets_in": ["UART", "EN", "BOOT", "+3V3", "GND"],
      "parts": [{ "ref": "TP*", "kind": "test-pad", "layer": "back" }]
    }
  ]
}
