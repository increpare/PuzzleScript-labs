(session pocket_card_controller
  (base_design pocket_card_controller)
  (placement
    (resolution um 10)
    (component "JST_GH_SM04B-GHS-TB_1x04-1MP_P1.25mm_Horizontal"
      (place J_I2C 120000 -545000 front 180)
      (place J_EXP 340000 -545000 front 180)
    )
    (component SW_SPDT_PCM12
      (place SW_PWR 200000 -885000 front 0)
      (place SW_MUTE 660000 -885000 front 0)
    )
    (component Panasonic_EVQPUJ_EVQPUA
      (place SW_MENU 396000 -854000 front 0)
      (place SW_UP 197000 -598000 front 0)
      (place SW_RESET 565000 -816000 front 0)
      (place SW_UNDO 604000 -658000 front 0)
      (place SW_RIGHT 287000 -688000 front 0)
      (place SW_ACTION 771000 -611000 front 0)
      (place SW_LEFT 107000 -688000 front 0)
      (place SW_DOWN 197000 -778000 front 0)
    )
    (component MountingHole_2.2mm_M2
      (place H1 650000 -560000 front 0)
      (place H2 800000 -720000 front 0)
    )
    (component "JST_GH_SM02B-GHS-TB_1x02-1MP_P1.25mm_Horizontal"
      (place J_BAT_IN 460000 -545000 front 180)
      (place J_BAT_OUT 560000 -545000 front 180)
    )
    (component "SOIC-28W_7.5x17.9mm_P1.27mm"
      (place U1 450000 -720000 front 0)
    )
  )
  (was_is
  )
  (routes 
    (resolution um 10)
    (parser
      (host_cad "KiCad's Pcbnew")
      (host_version 10.0.4)
    )
    (library_out 
      (padstack "Via[0-1]_600:300_um"
        (shape
          (circle F.Cu 6000 0 0)
        )
        (shape
          (circle B.Cu 6000 0 0)
        )
        (attach off)
      )
      (padstack "Via[0-1]_600:300_um"
        (shape
          (circle F.Cu 6000 0 0)
        )
        (shape
          (circle B.Cu 6000 0 0)
        )
        (attach off)
      )
    )
    (network_out 
      (net GND
        (wire
          (path F.Cu 2000
            696500 -877200
            696500 -899300
          )
        )
        (wire
          (path F.Cu 2000
            496500 -789850
            496500 -777150
          )
        )
      )
      (net +3V3
        (wire
          (path F.Cu 2000
            496500 -764450
            492735 -764450
            467335 -739050
            403500 -739050
          )
        )
      )
      (net SIG_UP
        (wire
          (path F.Cu 2000
            223250 -589500
            170750 -589500
          )
        )
      )
      (net SIG_UNDO
        (wire
          (path F.Cu 2000
            619983 -649500
            577750 -649500
          )
        )
        (wire
          (path F.Cu 2000
            630250 -649500
            619983 -649500
          )
        )
        (wire
          (path F.Cu 2000
            619983 -649500
            612466 -657017
            502333 -657017
            496500 -662850
          )
        )
      )
    )
  )
)